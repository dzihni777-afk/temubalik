rules_version = '2';

// ===========================================================================
// TemuBalik — Security Rules Firestore
//
// Cara pakai:
//   Firebase Console → Firestore Database → tab "Rules"
//   → tempel isi file ini → Publish.
//
// Ringkasan izin:
//   reports  → siapa pun boleh BACA dan MENAMBAH laporan.
//              Hanya admin (login Firebase Auth) yang boleh UBAH STATUS & HAPUS.
//   meta     → hanya dipakai untuk nomor urut laporan; tulis dibatasi.
//   lainnya  → ditolak semua.
//
// Admin ditentukan lewat custom claim `admin: true` pada akun.
// Lihat README-firebase.md langkah 6 untuk cara memasangnya.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- Helper ---------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = punya custom claim admin:true
    //         ATAU email-nya ada di daftar ADMIN_EMAILS di bawah.
    // Cara paling mudah: isi daftar email di bawah, tidak perlu set claim.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          "admin@temubalik.com"   // ← GANTI dengan email admin Anda
        ]
      );
    }

    /* ---------------- Laporan ---------------- */

    match /reports/{reportId} {

      // Publik boleh membaca daftar & detail laporan.
      allow read: if true;

      // Siapa pun boleh membuat laporan baru, TAPI isinya harus valid.
      allow create: if isValidNewReport(reportId);

      // Mengubah status (dan hanya status) → wajib admin.
      allow update: if isAdmin() && onlyStatusChanged();

      // Menghapus laporan → wajib admin.
      allow delete: if isAdmin();
    }

    /* ---------------- Aturan isi laporan ---------------- */

    function isValidNewReport(reportId) {
      let d = request.resource.data;

      return d.keys().hasAll([
               "id", "namaBarang", "kategori", "warna", "ciriKhusus",
               "tanggalHilang", "lokasi", "kronologi", "namaPelapor",
               "whatsapp", "status", "createdAt", "updatedAt"
             ])
        && d.id is string
        && d.id == reportId
        && d.id.size() <= 32

        // Status laporan baru harus "Aktif"
        && d.status == "Aktif"

        // Panjang teks dibatasi supaya tidak ada data sampah / terlalu besar
        && d.namaBarang is string && d.namaBarang.size() >= 3 && d.namaBarang.size() <= 120
        && d.namaPelapor is string && d.namaPelapor.size() >= 3 && d.namaPelapor.size() <= 80
        && d.ciriKhusus is string && d.ciriKhusus.size() >= 15 && d.ciriKhusus.size() <= 500
        && d.kronologi is string && d.kronologi.size() >= 20 && d.kronologi.size() <= 2000
        && d.warna is string && d.warna.size() > 0 && d.warna.size() <= 40
        && d.whatsapp is string && d.whatsapp.size() >= 9 && d.whatsapp.size() <= 20

        // Foto: hanya data URL gambar atau aset bawaan.
        // Batas 700.000 byte diselaraskan dengan js/form.js. Alasannya:
        // Firestore menolak dokumen > 1 MiB (1.048.576 byte) untuk SELURUH
        // dokumen, dan base64 membengkak ~33% dari ukuran biner. Batas lama
        // (4.000.000) mengizinkan foto yang pasti ditolak Firestore.
        && d.foto is string && d.foto.size() <= 700000
        && (
             d.foto.matches('^data:image/(png|jpeg|jpg|webp);base64,.*')
             || d.foto.matches('^assets/img/[A-Za-z0-9._-]+\\.(svg|png|jpe?g|webp)$')
           )

        // Tanggal kehilangan: format YYYY-MM-DD dan tidak di masa depan.
        // (Perbandingan string tanggal langsung tidak didukung di rules,
        //  jadi tahunnya dibandingkan dengan tahun berjalan.)
        && d.tanggalHilang is string
        && d.tanggalHilang.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && int(d.tanggalHilang.split('-')[0]) >= 2000
        && int(d.tanggalHilang.split('-')[0]) <= request.time.year()
        && int(d.tanggalHilang.split('-')[1]) >= 1
        && int(d.tanggalHilang.split('-')[1]) <= 12
        && int(d.tanggalHilang.split('-')[2]) >= 1
        && int(d.tanggalHilang.split('-')[2]) <= 31;
    }

    // Saat update, pastikan hanya field status & updatedAt yang berubah.
    function onlyStatusChanged() {
      let before = resource.data;
      let after  = request.resource.data;

      return after.diff(before).affectedKeys().hasOnly(["status", "updatedAt"])
        && after.status in ["Aktif", "Selesai"];
    }

    /* ---------------- Counter nomor laporan ---------------- */
    // Dokumen meta/counter-YYYYMMDD menyimpan angka urutan terakhir.
    // Publik boleh menaikkan angkanya, tapi tidak boleh menurunkan / merusak.

    match /meta/{counterId} {
      allow read: if true;

      allow create: if request.resource.data.value is number
                    && request.resource.data.value >= 1
                    && request.resource.data.value <= 100000;

      allow update: if request.resource.data.value is number
                    && request.resource.data.value == resource.data.value + 1;

      allow delete: if false;
    }

    /* ---------------- Sisanya ditolak ---------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

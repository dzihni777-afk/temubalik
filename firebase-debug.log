[debug] [2026-11-12T10:33:13.197Z] <<< [apiv2][status] POST https://firebaserules.googleapis.com/v1/projects/temubalik-26f80/rulesets 200
[debug] [2026-11-12T10:33:13.198Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/temubalik-26f80/rulesets {"name":"projects/temubalik-26f80/rulesets/08cb6568-3b1a-45e6-a1ff-40bf55245848","source":{"files":[{"content":"rules_version = '2';\n\n// ===========================================================================\n// TemuBalik — Security Rules Firestore\n//\n// Cara pakai:\n//   Firebase Console → Firestore Database → tab \"Rules\"\n//   → tempel isi file ini → Publish.\n//\n// Ringkasan izin:\n//   reports  → siapa pun boleh BACA dan MENAMBAH laporan.\n//              Hanya admin (login Firebase Auth) yang boleh UBAH STATUS & HAPUS.\n//   meta     → hanya dipakai untuk nomor urut laporan; tulis dibatasi.\n//   lainnya  → ditolak semua.\n//\n// Admin ditentukan lewat custom claim `admin: true` pada akun.\n// Lihat README-firebase.md langkah 6 untuk cara memasangnya.\n// ===========================================================================\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    /* ---------------- Helper ---------------- */\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    // Admin = punya custom claim admin:true\n    //         ATAU UID-nya ada di daftar ADMIN_UIDS\n    //         ATAU email-nya ada di daftar ADMIN_EMAILS di bawah.\n    //\n    // UID lebih aman daripada email: UID tidak bisa diubah dan tidak\n    // bergantung pada status verifikasi email. Email dipakai sebagai\n    // cadangan supaya tetap bisa masuk kalau akun dibuat ulang.\n    function isAdmin() {\n      return isSignedIn() && (\n        request.auth.token.admin == true ||\n        request.auth.uid in [\n          \"VHG3YKblzHQzqK0LCVpaKpAbquL2\"\n        ] ||\n        request.auth.token.email in [\n          \"dzihni777@gmail.com\"\n        ]\n      );\n    }\n\n    /* ---------------- Laporan ---------------- */\n\n    match /reports/{reportId} {\n\n      // Publik boleh membaca daftar & detail laporan.\n      allow read: if true;\n\n      // Siapa pun boleh membuat laporan baru, TAPI isinya harus valid.\n      allow create: if isValidNewReport(reportId);\n\n      // Mengubah status (dan hanya status) → wajib admin.\n      allow update: if isAdmin() && onlyStatusChanged();\n\n      // Menghapus laporan → wajib admin.\n      allow delete: if isAdmin();\n    }\n\n    /* ---------------- Aturan isi laporan ---------------- */\n\n    function isValidNewReport(reportId) {\n      let d = request.resource.data;\n\n      return d.keys().hasAll([\n               \"id\", \"namaBarang\", \"kategori\", \"warna\", \"ciriKhusus\",\n               \"tanggalHilang\", \"lokasi\", \"kronologi\", \"namaPelapor\",\n               \"whatsapp\", \"status\", \"createdAt\", \"updatedAt\"\n             ])\n        && d.id is string\n        && d.id == reportId\n        && d.id.size() <= 32\n\n        // Status laporan baru harus \"Aktif\"\n        && d.status == \"Aktif\"\n\n        // Panjang teks dibatasi supaya tidak ada data sampah / terlalu besar\n        && d.namaBarang is string && d.namaBarang.size() >= 3 && d.namaBarang.size() <= 120\n        && d.namaPelapor is string && d.namaPelapor.size() >= 3 && d.namaPelapor.size() <= 80\n        && d.ciriKhusus is string && d.ciriKhusus.size() >= 15 && d.ciriKhusus.size() <= 500\n        && d.kronologi is string && d.kronologi.size() >= 20 && d.kronologi.size() <= 2000\n        && d.warna is string && d.warna.size() > 0 && d.warna.size() <= 40\n        && d.whatsapp is string && d.whatsapp.size() >= 9 && d.whatsapp.size() <= 20\n\n        // Foto: hanya data URL gambar atau aset bawaan.\n        // Batas 700.000 byte diselaraskan dengan js/form.js. Alasannya:\n        // Firestore menolak dokumen > 1 MiB (1.048.576 byte) untuk SELURUH\n        // dokumen, dan base64 membengkak ~33% dari ukuran biner. Batas lama\n        // (4.000.000) mengizinkan foto yang pasti ditolak Firestore.\n        && d.foto is string && d.foto.size() <= 700000\n        && (\n             d.foto.matches('^data:image/(png|jpeg|jpg|webp);base64,.*')\n             || d.foto.matches('^assets/img/[A-Za-z0-9._-]+\\\\.(svg|png|jpe?g|webp)$')\n           )\n\n        // Tanggal kehilangan: format YYYY-MM-DD dan tidak di masa depan.\n        // (Perbandingan string tanggal langsung tidak didukung di rules,\n        //  jadi tahunnya dibandingkan dengan tahun berjalan.)\n        && d.tanggalHilang is string\n        && d.tanggalHilang.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')\n        && int(d.tanggalHilang.split('-')[0]) >= 2000\n        && int(d.tanggalHilang.split('-')[0]) <= request.time.year()\n        && int(d.tanggalHilang.split('-')[1]) >= 1\n        && int(d.tanggalHilang.split('-')[1]) <= 12\n        && int(d.tanggalHilang.split('-')[2]) >= 1\n        && int(d.tanggalHilang.split('-')[2]) <= 31;\n    }\n\n    // Saat update, pastikan hanya field status & updatedAt yang berubah.\n    function onlyStatusChanged() {\n      let before = resource.data;\n      let after  = request.resource.data;\n\n      return after.diff(before).affectedKeys().hasOnly([\"status\", \"updatedAt\"])\n        && after.status in [\"Aktif\", \"Selesai\"];\n    }\n\n    /* ---------------- Counter nomor laporan ---------------- */\n    // Dokumen meta/counter-YYYYMMDD menyimpan angka urutan terakhir.\n    // Publik boleh menaikkan angkanya, tapi tidak boleh menurunkan / merusak.\n\n    match /meta/{counterId} {\n      allow read: if true;\n\n      allow create: if request.resource.data.value is number\n                    && request.resource.data.value >= 1\n                    && request.resource.data.value <= 100000;\n\n      allow update: if request.resource.data.value is number\n                    && request.resource.data.value == resource.data.value + 1;\n\n      allow delete: if false;\n    }\n\n    /* ---------------- Sisanya ditolak ---------------- */\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-11-12T10:33:12.345471Z","metadata":{"services":["cloud.firestore"]},"attachmentPoint":"firestore.googleapis.com/projects/159124423766/databases/default"}

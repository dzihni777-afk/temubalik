# =============================================================================
# TemuBalik — Contoh variabel lingkungan
#
# SALIN file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
#
# File .env ASLI tidak boleh di-commit. File contoh ini aman dibagikan
# karena hanya berisi nama variabel, tanpa nilai rahasia.
# =============================================================================

# --- Kata sandi admin (backend Node.js, opsional) ----------------------------
# Cara disarankan: simpan HASH, bukan kata sandi asli.
# Buat hash dengan:
#   node -e "console.log(require('node:crypto').createHash('sha256').update('SANDI_ANDA').digest('hex'))"
ADMIN_PASSWORD_HASH=

# Khusus pengembangan lokal: kata sandi teks biasa.
# Jangan dipakai di server publik.
# ADMIN_PASSWORD=

# Kata sandi demo yang dipakai kalau ADMIN_PASSWORD_HASH kosong.
# Kosongkan di server publik supaya login demo mati.
ADMIN_DEMO_PASSWORD=

# Masa berlaku token admin dalam milidetik (default 2 jam = 7200000).
# ADMIN_TOKEN_TTL_MS=7200000

# --- Server ---------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1

# Lokasi file penyimpanan backend (default: server/storage/reports.json).
# TEMUBALIK_STORE=

# --- Firebase (untuk skrip deploy / admin SDK) ----------------------------
# Simpan file service account DI LUAR repo, lalu tunjuk lewat variabel ini.
# GOOGLE_APPLICATION_CREDENTIALS=/path/di/luar/repo/service-account.json

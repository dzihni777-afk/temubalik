# =============================================================================
# TemuBalik — Contoh variabel lingkungan
#
# SALIN file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
#
# File .env ASLI tidak boleh di-commit. File contoh ini aman dibagikan
# karena hanya berisi nama variabel, tanpa nilai rahasia.
# =============================================================================

# --- Kata sandi admin (backend Node.js, opsional) ----------------------------
# Cara disarankan: simpan HASH, bukan kata sandi asli.
# Buat hash dengan:
#   node -e "console.log(require('node:crypto').createHash('sha256').update('SANDI_ANDA').digest('hex'))"
ADMIN_PASSWORD_HASH=

# Khusus pengembangan lokal: kata sandi teks biasa.
# Jangan dipakai di server publik.
# ADMIN_PASSWORD=

# ⚠️ HATI-HATI: `ADMIN_PASSWORD` di atas dibaca oleh server/auth.js sebagai
# kata sandi panel BACKEND. Jangan pakai nama itu untuk menyimpan kata sandi
# akun admin Firebase — nanti sandi server ikut berubah tanpa disengaja.
# Untuk catatan akun admin Firebase, pakai nama berawalan FIREBASE_ADMIN_*
# (mis. FIREBASE_ADMIN_PASSWORD) yang tidak dibaca kode mana pun.

# Kata sandi demo yang dipakai kalau ADMIN_PASSWORD_HASH kosong.
# Kosongkan di server publik supaya login demo mati.
ADMIN_DEMO_PASSWORD=

# Masa berlaku token admin dalam milidetik (default 2 jam = 7200000).
# ADMIN_TOKEN_TTL_MS=7200000

# --- Server ---------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1

# Lokasi file penyimpanan backend (default: server/storage/reports.json).
# TEMUBALIK_STORE=

# --- Firebase (untuk skrip deploy / admin SDK) ----------------------------
# Simpan file service account DI LUAR repo, lalu tunjuk lewat variabel ini.
# GOOGLE_APPLICATION_CREDENTIALS=/path/di/luar/repo/service-account.json

# =============================================================================
# Firebase Web — dipakai js/firebase-config.js (dihasilkan `npm run config`)
#
# Ambil nilainya dari Firebase Console → Project settings → Your apps
# → konfigurasi SDK Firebase.
#
# Kalau bagian ini kosong, `npm run config` akan berhenti dan memberi tahu
# variabel mana yang kurang.
# =============================================================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ID database Firestore:
#   "(default)" → database dibuat lewat Firebase Console
#   "default"   → database dibuat lewat Google Cloud Console
# Keduanya database BERBEDA. Isi persis seperti yang tampil di Console.
FIREBASE_DATABASE_ID=(default)

# Nama koleksi tempat laporan disimpan.
FIREBASE_COLLECTION=reports

# Set false untuk mematikan Firebase dan memakai localStorage saja.
FIREBASE_ENABLED=true

# Kata sandi demo untuk mode lokal (saat Firebase tidak aktif).
# HANYA berlaku di localhost / 127.0.0.1 / file:// — di domain publik ditolak.
# Kosongkan di server publik supaya login demo mati.
FIREBASE_DEMO_PASSWORD=
